{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/systems-learning-loops/experience-record.v0.1.json",
  "title": "Experience Record v0.1",
  "description": "One trajectory step of the self-improving loop (the experience generator: generate -> measure -> keep-if-better). Pins a QUANTITATIVE improvement claim. Enforced by scripts/validate_experience_records.py: an improvement claim must carry a measured, consistent delta in the improving direction; effective n < 30 may not be promoted past 'provisional' (estate min-n rule); and provenance is a recomputed SHA-256 receipt (FIPS 180-4).",
  "type": "object",
  "additionalProperties": true,
  "required": ["record_id", "status", "date", "loop", "task", "improvement", "evidence_refs", "evidence_grade", "claim_boundary", "receipt"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^il\\.experience\\."},
    "status": {"type": "string", "enum": ["provisional", "active", "superseded", "revoked"]},
    "date": {"type": "string", "minLength": 1},
    "loop": {
      "type": "object",
      "required": ["loop_id", "round", "generator"],
      "properties": {
        "loop_id": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 0},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "task": {"type": "string", "minLength": 1},
    "improvement": {
      "type": "object",
      "required": ["metric", "direction", "baseline", "candidate", "delta"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["higher_better", "lower_better"]},
        "baseline": {"$ref": "#/$defs/endpoint"},
        "candidate": {"$ref": "#/$defs/endpoint"},
        "delta": {"type": "number", "description": "candidate.value - baseline.value; recomputed and checked by the validator"},
        "relative_delta": {"type": "number"}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_grade": {"type": "string", "minLength": 1, "description": "cf. metadata-standards evidence_grade"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "reobservation": {"type": "object"},
    "receipt": {
      "type": "object",
      "required": ["algorithm", "input_hash", "receipt_hash"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256(canonical(improvement))"},
        "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "sha256(canonical(record minus receipt.receipt_hash))"}
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["value", "n"],
      "properties": {
        "value": {"type": "number"},
        "n": {"type": "integer", "minimum": 0, "description": "sample size; effective n = min(baseline.n, candidate.n) must be >= 30 to claim 'active'"}
      }
    }
  }
}
